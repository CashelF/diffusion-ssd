\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Left:} standard speculative decoding alternates draft and verify on the same hardware, so the draft model is idle during verification. \textbf  {Middle:} S$^2$D runs draft and verify in parallel by speculating against multiple predicted verification outcomes; on a hit (green leaf) the next block is already in hand. \textbf  {Right:} this work replaces the AR drafter inside the S$^2$D loop with a discrete diffusion drafter that fills an entire block in $R$ parallel refinement steps. The bar chart shows headline tokens/s on \texttt  {Llama-3.3 70B} with AR, SD, and S$^2$D drafts; the empty slot for ``diffusion-S$^2$D'' is the target of this work. \relax }}{4}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{4}{\textbf {Left:} standard speculative decoding alternates draft and verify on the same hardware, so the draft model is idle during verification. \textbf {Middle:} S$^2$D runs draft and verify in parallel by speculating against multiple predicted verification outcomes; on a hit (green leaf) the next block is already in hand. \textbf {Right:} this work replaces the AR drafter inside the S$^2$D loop with a discrete diffusion drafter that fills an entire block in $R$ parallel refinement steps. The bar chart shows headline tokens/s on \texttt {Llama-3.3 70B} with AR, SD, and S$^2$D drafts; the empty slot for ``diffusion-S$^2$D'' is the target of this work. \relax }{figure.caption.7}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][3][]4}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces End-to-end throughput on \texttt  {Llama-3.3 70B}, averaged over $4{\times }128 = 512$ prompts (HumanEval, Alpaca, GSM8K, UltraFeedback). Greedy, $512$ output tokens, batch $1$, $4{\times }$H100; S$^2$D uses a $5^{\text  {th}}$ H100 for the draft. Speedups vs.\ AR baseline.\relax }}{4}{table.caption.13}\protected@file@percent }
\newlabel{tab:throughput-70b}{{1}{4}{End-to-end throughput on \texttt {Llama-3.3 70B}, averaged over $4{\times }128 = 512$ prompts (HumanEval, Alpaca, GSM8K, UltraFeedback). Greedy, $512$ output tokens, batch $1$, $4{\times }$H100; S$^2$D uses a $5^{\text {th}}$ H100 for the draft. Speedups vs.\ AR baseline.\relax }{table.caption.13}{}}
\newlabel{tab:throughput-70b@cref}{{[table][1][]1}{[1][3][]4}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mean accepted suffix length per verify step (tokens) by dataset. Target \texttt  {Qwen3-1.7B}; AR drafter is \texttt  {Qwen3-0.6B}; block-diffusion drafter is BD3LM with staircase attention, first-hitting sampler, prefix-KV cache, $R=4$. Higher is better.\relax }}{4}{table.caption.14}\protected@file@percent }
\newlabel{tab:throughput-qwen}{{2}{4}{Mean accepted suffix length per verify step (tokens) by dataset. Target \texttt {Qwen3-1.7B}; AR drafter is \texttt {Qwen3-0.6B}; block-diffusion drafter is BD3LM with staircase attention, first-hitting sampler, prefix-KV cache, $R=4$. Higher is better.\relax }{table.caption.14}{}}
\newlabel{tab:throughput-qwen@cref}{{[table][2][]2}{[1][3][]4}}
